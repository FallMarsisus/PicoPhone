{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "PlatformIO Clean Build",
			"type": "shell",
			"command": "$HOME/.platformio/penv/bin/platformio",
			"args": [
				"run",
				"-t",
				"clean",
				"&&",
				"$HOME/.platformio/penv/bin/platformio",
				"run"
			],
			"isBackground": false
		},
		{
			"label": "PlatformIO Build",
			"type": "shell",
			"command": "$HOME/.platformio/penv/bin/platformio",
			"args": [
				"run"
			],
			"isBackground": false
		}
	]
}